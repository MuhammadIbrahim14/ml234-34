# MarketLink — copy to .env.local for Vite, and set the same keys in Netlify UI.
# Never commit real secrets. Use the Supabase Project Settings → API values.

# Required for auth + database
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: public site URL used in docs / auth redirects (Netlify domain)
VITE_SITE_URL=http://localhost:5173

# Optional demo note (not used by code — for documentation only)
# After creating users in Supabase Auth, promote one profile role to 'admin' via SQL:
#   update public.profiles set role = 'admin', status = 'active' where email = 'admin@marketlink.local';
